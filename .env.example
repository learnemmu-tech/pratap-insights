# Development uses the same names as production. Values differ per environment.
# Neon pooled connection string. Used by the running application.
DATABASE_URL=
# Neon direct connection string. Used only by Drizzle Kit migrations.
DATABASE_URL_UNPOOLED=

# Clerk. Use the existing application keys. Do not generate a second application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/register

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend. Without these, messages stay in the email outbox.
RESEND_API_KEY=
EMAIL_FROM=

# Supabase Storage. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Optional scheduled-publish endpoint.
CRON_SECRET=

# Email address of the existing Clerk user who should receive the administrator role.
ADMIN_EMAIL=
